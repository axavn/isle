<UserControl x:Class="IsleWin.Claude.ClaudeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IsleWin.Claude"
             Width="468" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White">
    <!-- Isle (macOS) Claude face: the marker as a big "wing" on the left, the text column on the right. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <SolidColorBrush x:Key="Sec" Color="#B3FFFFFF"/>   <!-- white 0.7 -->
        <SolidColorBrush x:Key="MetaT" Color="#80FFFFFF"/> <!-- white 0.5 -->

        <!-- capsule pill: label font (12 semibold), 22 high -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="22"/><Setter Property="Padding" Value="12,0"/><Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- question option: card (radius 9, white 0.07), label + description -->
        <Style x:Key="Option" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#12FFFFFF" CornerRadius="9" MinHeight="22" Padding="8,3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="114"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- the wing: reaches up into the band like the album art does -->
        <local:DotMatrix Width="114" Height="114" VerticalAlignment="Center"
                         State="{Binding State}" Primary="{Binding PalettePrimary}" Secondary="{Binding PaletteSecondary}" Accent="{Binding PaletteAccent}">
            <local:DotMatrix.RenderTransform><TranslateTransform Y="-11"/></local:DotMatrix.RenderTransform>
        </local:DotMatrix>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <!-- meta: 📁 project · 3s ago            +2 > -->
            <DockPanel Height="18">
                <Button DockPanel.Dock="Right" Command="{Binding NextSession}" Visibility="{Binding HasMore, Converter={StaticResource B2V}}" Cursor="Hand" Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#1AFFFFFF" CornerRadius="9" Height="18" Padding="7,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MoreText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Sec}"/>
                                    <Path Data="M9,4.5 L16.5,12 L9,19.5" Stretch="Uniform" Width="6" Height="8" Stroke="{StaticResource Sec}" StrokeThickness="1.6" Margin="4,0,0,0"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M2,6.5 A2.5,2.5 0 0 1 4.5,4 H9 L11,6 H19.5 A2.5,2.5 0 0 1 22,8.5 V17.5 A2.5,2.5 0 0 1 19.5,20 H4.5 A2.5,2.5 0 0 1 2,17.5 Z"
                          Fill="{StaticResource Sec}" Stretch="Uniform" Width="11" Height="11" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Project}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Sec}"/>
                    <TextBlock Text=" · " FontSize="11" Foreground="#4DFFFFFF"/>
                    <TextBlock Text="{Binding Ago}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource MetaT}"/>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasQuestionHeader, Converter={StaticResource B2V}}">
                        <TextBlock Text=" · " FontSize="11" Foreground="#4DFFFFFF"/>
                        <TextBlock Text="&#xE9CE;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource Sec}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding QuestionHeader}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Sec}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- headline (title 17 semibold); a question shows its text instead (headline 13 semibold) -->
            <TextBlock Text="{Binding Headline}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                    <DataTrigger Binding="{Binding ShowQuestion}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding QuestionText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="36" Margin="0,4,0,6"
                       Visibility="{Binding ShowQuestion, Converter={StaticResource B2V}}"/>

            <!-- detail (body 12, 70%) -->
            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Sec}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="33" Margin="0,2,0,0"
                       Visibility="{Binding HasDetail, Converter={StaticResource B2V}}"/>

            <!-- approval: the command in a card -->
            <Border Background="#12FFFFFF" CornerRadius="9" Padding="10,6" Margin="0,4,0,0" Visibility="{Binding ShowApproval, Converter={StaticResource B2V}}">
                <TextBlock Text="{Binding PendingSummary}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#D9FFFFFF" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30"/>
            </Border>

            <!-- question: one card per option -->
            <ItemsControl ItemsSource="{Binding QuestionChoices}" Visibility="{Binding ShowQuestion, Converter={StaticResource B2V}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Option}" Command="{Binding DataContext.Answer, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Label}">
                            <TextBlock TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Label, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                <Run Text="  "/>
                                <Run Text="{Binding Description, Mode=OneWay}" FontSize="11" Foreground="#80FFFFFF"/>
                            </TextBlock>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- actions (22 high) -->
            <Grid Margin="0,6,0,0" Height="22">
                <!-- approval: Approve / Deny / Terminal -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowApproval, Converter={StaticResource B2V}}">
                    <Button Style="{StaticResource Pill}" Command="{Binding Allow}" Background="#D934C759">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Approve"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Pill}" Command="{Binding Deny}" Background="#D9FF3B30">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Deny"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Pill}" Command="{Binding Jump}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M7,3 H17 A4,4 0 0 1 21,7 V17 A4,4 0 0 1 17,21 H7 A4,4 0 0 1 3,17 V7 A4,4 0 0 1 7,3 Z M9.5,14.5 L15,9 M10.5,9 H15 V13.5" Stroke="White" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="12" Height="12" Margin="0,0,7,0"/>
                            <TextBlock Text="Terminal"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- question: Answer in terminal -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowQuestion, Converter={StaticResource B2V}}">
                    <Button Style="{StaticResource Pill}" Command="{Binding Jump}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Answer in terminal"/></StackPanel>
                    </Button>
                </StackPanel>
                <!-- otherwise: Terminal + Reply to Claude… -->
                <Grid x:Name="ReplyRow">
                    <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                        <DataTrigger Binding="{Binding ShowApproval}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        <DataTrigger Binding="{Binding ShowQuestion}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource Pill}" Command="{Binding Jump}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M7,3 H17 A4,4 0 0 1 21,7 V17 A4,4 0 0 1 17,21 H7 A4,4 0 0 1 3,17 V7 A4,4 0 0 1 7,3 Z M9.5,14.5 L15,9 M10.5,9 H15 V13.5" Stroke="White" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="12" Height="12" Margin="0,0,7,0"/>
                            <TextBlock Text="Terminal"/>
                        </StackPanel>
                    </Button>
                    <Border Grid.Column="1" Background="#0FFFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="11">
                        <Grid>
                            <Path Data="M10,4.5 L2.5,11 L10,17.5 V13.6 C15.2,13.6 18.6,15.2 21.5,19.5 C20.8,13.4 17.4,8.9 10,8.4 Z" Fill="#80FFFFFF" Stretch="Uniform" Width="11" Height="10"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                            <TextBox x:Name="Reply" Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                                     FontSize="12" Padding="24,0,8,0" VerticalContentAlignment="Center"
                                     GotKeyboardFocus="OnFocus" LostKeyboardFocus="OnLostFocus" PreviewMouseDown="OnMouseDown" PreviewKeyDown="OnKey"/>
                            <TextBlock FontSize="12" FontWeight="Medium" Foreground="#80FFFFFF" Margin="27,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Reply to Claude…"/><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Reply}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <TextBlock Text="{Binding ReplyStatus}" FontSize="10" FontWeight="Medium" Foreground="{StaticResource MetaT}" Margin="2,3,0,0" TextTrimming="CharacterEllipsis">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                    <DataTrigger Binding="{Binding ReplyStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
