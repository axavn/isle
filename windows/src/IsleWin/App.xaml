<Application x:Class="IsleWin.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="TextBrush" Color="#F4F3EE"/>
    <SolidColorBrush x:Key="SecBrush" Color="#9C9A92"/>
    <SolidColorBrush x:Key="CtlBrush" Color="#1C1C1A"/>
    <SolidColorBrush x:Key="CtlBorderBrush" Color="#3A3A37"/>
    <SolidColorBrush x:Key="BarBrush" Color="#5DCAA5"/>
    <Style x:Key="RoundBtn" TargetType="Button">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="5,0"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="15" Background="{StaticResource CtlBrush}" BorderBrush="{StaticResource CtlBorderBrush}" BorderThickness="1">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#6A6A66"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#2A2A28"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
